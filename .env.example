# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SQLITE_DB_PATH: Optional override path for the SQLite database file.
# Defaults to ./studymate.db in the project root when unset or blank.
# Set to a persistent disk path in production (e.g. /var/data/studymate.db).
# SQLITE_DB_PATH="./studymate.db"

# BOOTSTRAP_ADMIN_*: Optional initial admin bootstrap used ONLY if zero active admins exist in SQLite.
# Never overwrites existing accounts or passwords.
# BOOTSTRAP_ADMIN_EMAIL=""
# BOOTSTRAP_ADMIN_PASSWORD=""
# BOOTSTRAP_ADMIN_NAME="StudyMate Administrator"
